# ─────────────────────────────────────────────────────────────
# Google Drive
# ─────────────────────────────────────────────────────────────

# Carpeta raíz que contiene una subcarpeta por video (Video 41, Video 43, ...).
# Acepta el ID o la URL completa de Drive.
DRIVE_FOLDER_ID=1ZlHAzBLG40AgwH_Umh-YOCd4M1BGurzt

# Subcarpeta (proyecto) a descargar. Nombre exacto, parcial o ID.
# Si se omite, hay que pasarlo por CLI: npm run fetch-drive -- --project "Video 41"
DRIVE_PROJECT_FOLDER=Video 41

# Tipos de asset a descargar: video, audio, image, other.
DRIVE_ASSET_KINDS=video,audio,image

# Opcional: fuerza el clip principal (coincidencia parcial por nombre o ID).
# DRIVE_MAIN_CLIP=DSCF7555.MOV

# Tope de tamaño por archivo en MB (evita bajar sobrantes gigantes).
MAX_FILE_SIZE_MB=4096

# ─────────────────────────────────────────────────────────────
# Credenciales: usa OPCIÓN A o OPCIÓN B (no ambas)
# ─────────────────────────────────────────────────────────────

# OPCIÓN A — Service Account (recomendada para automatización / CI).
# Ruta al JSON, el JSON completo en una línea, o el JSON en base64.
# Importante: comparte la carpeta de Drive con el email client_email de la
# Service Account, si no devuelve 404.
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials.json
# Solo con delegación de dominio en Google Workspace:
# GOOGLE_IMPERSONATE_USER=tu-usuario@tu-dominio.com

# OPCIÓN B — OAuth2 con tu cuenta personal (sirve para carpetas que
# ya están compartidas contigo y que no puedes compartir con la Service Account).
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxxxxx

# ─────────────────────────────────────────────────────────────
# Render
# ─────────────────────────────────────────────────────────────
INPUT_DIR=public/input
OUTPUT_FILE=out/final.mp4
REMOTION_COMPOSITION=VerticalClip
HOOK_TEXT=Energía renovable, negociada en minutos
ACCENT_COLOR=#22D3EE
# Recorta el clip a N segundos (0 = duración completa del video fuente).
MAX_CLIP_SECONDS=0
